# محافظت از فایل‌های حساس
<FilesMatch "\.(php)$">
  # اجازه‌ی اجرا — ولی فایل‌های زیر مستقیم قابل دسترسی نباشند
</FilesMatch>

<Files "config.php">
  Require all denied
</Files>

<FilesMatch "^(Database|Auth|Csrf|Persons|.*Driver|ChannelInterface)\.php$">
  Require all denied
</FilesMatch>

# پوشه‌های داخلی مستقیم سرو نشوند
# 2.2.0: الگوهای قبلی فقط وقتی کار می‌کردند که برنامه در یک زیرپوشه نصب شده بود (مثلاً /marketing/core/…)؛
# روی ریشه‌ی دامنه (/core/…) محافظتی نبود. الگوهای جدید هر دو حالت را می‌پوشانند. crm/ و api.php دست نخورده‌اند.
RedirectMatch 403 ^(/.*)?/(core|modules|channels|src|migrations|tools|tests|docs|data|cli)/
RedirectMatch 403 ^(/.*)?/(logs)(/|$)
RedirectMatch 403 ^(/.*)?/config\.php$
RedirectMatch 403 ^(/.*)?/api/[^/]+\.php$
